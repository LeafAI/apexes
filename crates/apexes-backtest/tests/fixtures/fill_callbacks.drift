let returned_id = null;
let direct_quantity = 0;
let resting_quantity = 0;
let resting_completed = false;

function on_order_terminal(outcome) {
    if (outcome.kind == "filled" && outcome.symbol == "BTCUSDT" &&
        outcome.quantity == 3 && outcome.filled_quantity == 3 &&
        outcome.order_id != null && resting_quantity == 3) {
        resting_completed = true;
    }
    return [{ symbol: outcome.symbol, venue: outcome.venue, asset_class: "spot",
        side: "buy", order_type: "market", quantity: 999 }];
}

function on_order_outcome(outcome) {
    if (outcome.kind == "returned" && outcome.order_status == "filled") {
        returned_id = outcome.order_id;
    }
}

function on_fill(fill) {
    if (fill.symbol == "BTCUSDT" && fill.venue == "binance" &&
        fill.source == "direct" && fill.order_id == returned_id &&
        fill.price == 100 && fill.fee_currency == null && fill.fee == 0.1) {
        direct_quantity = direct_quantity + fill.quantity;
    }
    if (fill.source == "resting" && fill.price == 99) {
        resting_quantity = resting_quantity + fill.quantity;
    }
    return [{ symbol: fill.symbol, venue: fill.venue, asset_class: "spot",
        side: "buy", order_type: "market", quantity: 999 }];
}

function on_market_event(event, ctx) {
    if (event.type == "trade" && event.price == 100 && direct_quantity == 0) {
        return [{ symbol: event.symbol, venue: event.venue, asset_class: "spot",
            side: "buy", order_type: "market", quantity: 1 }];
    }
    if (event.type == "tick" && direct_quantity == 1 && resting_quantity == 0) {
        direct_quantity = 2;
        return [{ symbol: event.symbol, venue: event.venue, asset_class: "spot",
            side: "buy", order_type: "limit", quantity: 3, price: 99 }];
    }
    if (event.type == "tick" && resting_quantity == 3 && resting_completed) {
        resting_quantity = 4;
        return [{ symbol: event.symbol, venue: event.venue, asset_class: "spot",
            side: "sell", order_type: "market", quantity: 1 }];
    }
    return [];
}
