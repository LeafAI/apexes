let filled = false;
let rejected = false;
let scheduled = false;
let scheduled_id = null;
let duplicate = false;

function on_order_outcome(outcome) {
    if (outcome.kind == "scheduled" && outcome.stage == "decision" &&
        outcome.order_id == null && outcome.order_status == null && outcome.quantity == 1) {
        scheduled = outcome.intent_id == "1" || outcome.intent_id == "4";
        scheduled_id = outcome.intent_id;
    }
    if (outcome.kind == "rejected" && outcome.code == "risk_rejected" &&
        outcome.quantity == 9 && outcome.order_id == null) {
        rejected = outcome.intent_id == "2";
    }
    if (outcome.kind == "rejected" && outcome.code == "event_latency_symbol_pending") {
        duplicate = outcome.intent_id == "3";
    }
    if (outcome.kind == "returned" && outcome.stage == "arrival" &&
        outcome.order_status == "filled" && outcome.order_id != null &&
        outcome.filled_quantity == 1 && outcome.intent_id == scheduled_id) {
        filled = true;
    }
    // Notification return values must never cause an order to be submitted.
    return [{ symbol: outcome.symbol, venue: outcome.venue, asset_class: "spot",
        side: "buy", order_type: "market", quantity: 500 }];
}

function on_market_event(event, ctx) {
    if (event.type == "trade" && event.price == 100) {
        return [
            { symbol: event.symbol, venue: event.venue, asset_class: "spot", side: "buy", order_type: "market", quantity: 1 },
            { symbol: event.symbol, venue: event.venue, asset_class: "spot", side: "buy", order_type: "market", quantity: 9 },
            { symbol: event.symbol, venue: event.venue, asset_class: "spot", side: "buy", order_type: "market", quantity: 1 },
        ];
    }
    if (event.type == "tick" && filled && rejected && scheduled && duplicate) {
        filled = false;
        return [{ symbol: event.symbol, venue: event.venue, asset_class: "spot",
            side: "buy", order_type: "limit", quantity: 1, price: 99 }];
    }
    return [];
}
