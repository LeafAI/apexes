// All mutable trading state lives in the scoped context and parameter store.
let initial_factor = param("initial_factor", 2);
function on_market_event(event, ctx) {
    if (event.type != "trade") { return []; }
    let count = ctx.state_get("count", 0) + 1;
    ctx.state_set("count", count);
    let previous = ctx.state_get("previous", [0, 0]);
    ctx.state_set("previous", [previous[1], event.price]);
    let mean = ctx.indicators.sma("mean", 3, event.price);
    let ema = ctx.indicators.ema("ema", 3, event.price);
    let rsi = ctx.indicators.rsi("rsi", 2, event.price);
    let grant = ctx.time.try_cooldown("entry", 1000);
    let hot = param("hot", 1);
    if (event.price == 998) { return 42; }
    if (!grant || mean == null || ema == null || rsi == null) { return []; }
    return [{
        symbol: event.symbol,
        venue: event.venue,
        asset_class: "spot",
        side: "buy",
        order_type: "market",
        quantity: mean + count + initial_factor + hot,
    }];
}
