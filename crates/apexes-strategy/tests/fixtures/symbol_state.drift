function on_market_event(event, ctx) {
  if (event.type != "trade") {
    return [];
  }
  let count = ctx.state_get("count", 0) + 1;
  let old = ctx.state_get("prices", [0, 0]);
  let window = [old[0], old[1], event.price];
  ctx.state_set("count", count);
  ctx.state_set("prices", [old[1], event.price]);
  if (event.price == 999) {
    // Functions/objects are not durable data.
    ctx.state_set("invalid", {value: 1});
  }
  if (event.price == 998) {
    return 42;
  }
  if (count < 3) {
    return [];
  }
  return [{
    symbol: event.symbol,
    venue: event.venue,
    asset_class: "spot",
    side: "buy",
    order_type: "market",
    quantity: math.mean(window),
  }];
}
