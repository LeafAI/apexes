function on_market_event(event, ctx) {
  let threshold = param("threshold", 0.2);

  if (event.price > threshold) {
    return [{
      symbol: event.symbol,
      venue: event.venue,
      asset_class: "spot",
      side: "buy",
      order_type: "market",
      quantity: 1,
    }];
  }

  return [];
}
