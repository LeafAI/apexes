// DEMO ONLY. Not a trading recommendation, and not expected to make money.
//
// It exists to exercise the whole pipeline (market data -> strategy -> risk
// limits -> orders -> fills -> console) and live parameter tuning, on the
// Binance Spot TESTNET. A trend-following toy: hold `quantity` of the base
// asset while the latest trade price is above its simple moving average,
// and be flat otherwise.
//
// Tunable from the console while running. `param()` is read INSIDE
// on_market_event on purpose: a top-level param() is read once at load and
// would not change when you edit it.
//
//   notional  value to hold when "long", in the quote currency (USDT). The
//             base quantity is derived from the latest price, so the same
//             strategy works for BTC and ETH. Keep it above the exchange's
//             minimum order value (5 USDT on the Binance Spot testnet) or
//             every order is rejected with a NOTIONAL filter failure.
//   step      the smallest quantity increment the exchange accepts, in base
//             units. 0.0001 is valid for both BTCUSDT and ETHUSDT. Quantities
//             that are not a multiple of it fail the exchange's LOT_SIZE
//             filter.
//   enabled   1 = trade, 0 = stay flat (use this to stop trading without
//             stopping the session)
//
// The launch config's risk limits are in BASE units of each symbol, so they
// must be at least notional / price (see USAGE.md).

let sma = indicators.sma(20);

function on_market_event(event, ctx) {
  // Trades only; ticks/bars/depth are ignored.
  if (event.type != "trade") {
    return [];
  }

  let notional = param("notional", 20);
  let step = param("step", 0.0001);
  let enabled = param("enabled", 1);

  let average = sma.update(event.price);
  if (average == null) {
    // Still warming up: not enough trades to form an average yet.
    return [];
  }

  // Whole multiples of `step`, rounded down, so the order is always valid.
  let target = math.floor(notional / event.price / step) * step;
  if (target <= 0) {
    return [];
  }

  let position = ctx.get_position(event.symbol);
  let held = position.quantity;

  // One working order at a time: never stack orders on top of each other.
  if (ctx.has_open_order(event.symbol)) {
    return [];
  }

  let want_long = enabled > 0 && event.price > average;

  // Work in whole `step`s so floating-point residue (target - held can leave
  // something like 1e-18 when they are equal) is never sent as an order.
  let missing = math.floor((target - held) / step + 0.5) * step;
  if (want_long && missing >= step) {
    return [{
      symbol: event.symbol,
      venue: event.venue,
      asset_class: "spot",
      side: "buy",
      order_type: "market",
      quantity: missing,
    }];
  }

  if (!want_long && held >= step) {
    return [{
      symbol: event.symbol,
      venue: event.venue,
      asset_class: "spot",
      side: "sell",
      order_type: "market",
      quantity: math.floor(held / step + 0.5) * step,
    }];
  }

  return [];
}
